# .env.example
# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the site. Share links and post-login redirects are built from this
# (never from the request's Host header). Required in production unless the host
# provides URL (Netlify) or VERCEL_PROJECT_PRODUCTION_URL (Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── NOTE: AI API keys are NEVER stored here ──────────────────────────────────
# Users bring their own keys (BYOK) — entered in the UI, stored in sessionStorage only.
# Keys flow: browser → /api/analyze → AI provider — never stored in our DB or logs.

# ─── Local models (optional, for running everything on your machine) ──────────
# Shows a "Local" provider that talks to Ollama, LM Studio, llama.cpp server or
# any OpenAI-compatible API. The URL is read on the server only.
#   Ollama:    ollama serve  →  http://127.0.0.1:11434/v1   (e.g. `ollama pull llama3.1:8b`)
#   LM Studio: Developer tab → Start server  →  http://127.0.0.1:1234/v1
# NEXT_PUBLIC_ENABLE_LOCAL_LLM=true
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=            # only if your local server requires one

# ─── LLM diagnostics (optional) ───────────────────────────────────────────────
# Failed model calls are always logged as "[llm] … failed …" lines in the server
# terminal. Set LLM_DEBUG=1 to also log successful calls with their timing.
# LLM_DEBUG=1
# Per-call time limit in ms (default 60000, or 180000 for local models).
# Hosting platforms cap function time (Netlify/Vercel ~60s), so raise it only locally.
# LLM_TIMEOUT_MS=120000
