# .env.example
# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the site. Share links and post-login redirects are built from this
# (never from the request's Host header). Required in production unless the host
# provides URL (Netlify) or VERCEL_PROJECT_PRODUCTION_URL (Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── NOTE: AI API keys are NEVER stored here ──────────────────────────────────
# Users bring their own keys (BYOK) — entered in the UI, stored in sessionStorage only.
# Keys flow: browser → /api/analyze → AI provider — never stored in our DB or logs.
